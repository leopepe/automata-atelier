# --- Rust / Cargo ---------------------------------------------------------

# Rust build output (matches root and any nested grafo/target etc.)
target/

# Cargo lockfile is committed.
# This workspace ships a binary (uncharles), so reproducible builds win
# over the per-consumer "fresh resolution" policy that suits pure-library
# crates. Committing the lockfile also stabilises the bench-regression
# CI gate: dev-deps stay pinned across base→PR-head bench runs, removing
# one source of noise from the comparison.

# Backup files produced by cargo fix / rustfmt
**/*.rs.bk

# Generated by perf-style tooling
*.profraw
flamegraph.svg
perf.data*

# --- Editors / IDEs -------------------------------------------------------

.idea/
.vscode/
*.swp
*.swo
*~

# Claude Code workspace state — local-only settings, transcripts, memory.
.claude/

# --- OS junk --------------------------------------------------------------

.DS_Store
Thumbs.db

# --- Secrets & local config ----------------------------------------------
# Anything matching these patterns is assumed to contain credentials.
# If you ever need to commit one, add an explicit `!path/to/file` exception.

.env
.env.*
*.env
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
credentials
credentials.*
secrets
secrets.*
*.secrets
service-account*.json
gcp-key*.json
aws-credentials*

# Local-only overrides for uncharles configs
*.local.yaml
*.local.yml
config.local.*
